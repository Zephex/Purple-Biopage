[Unit]
Description=Personal bio page and Spotify presence endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bioapp
Group=bioapp
WorkingDirectory=/opt/personal-bio
EnvironmentFile=/etc/personal-bio.env
ExecStart=/usr/bin/node /opt/personal-bio/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/personal-bio

[Install]
WantedBy=multi-user.target
